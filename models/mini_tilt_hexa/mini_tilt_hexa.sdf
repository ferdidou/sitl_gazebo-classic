        <inertia><ixx>0.00095</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00095</iyy><iyz>0</iyz><izz>0.00155</izz></inertia></inertial>
      <collision name='base_link_collision'><pose>0 0 0.026 0 0 0</pose>
        <geometry><cylinder><length>0.058</length><radius>0.088</radius></cylinder></geometry>
        <surface><contact><ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode></contact>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name='base_link_visual'><pose>0 0 0 0 0 0</pose>
        <geometry><mesh><scale>1 1 1</scale><uri>model://mini_tilt_hexa/meshes/base.dae</uri></mesh></geometry></visual>
      <gravity>1</gravity><velocity_decay/><self_collide>0</self_collide>
    </link>

    <link name='/imu_link'>
