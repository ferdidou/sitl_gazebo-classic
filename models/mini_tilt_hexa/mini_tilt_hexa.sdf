<?xml version='1.0'?>
<!-- Mini-Tilt Drone (SMART/Saxion), generated from the "Tiltrotor V1" STEP assembly.
     Arm radius 0.1753 m, 5x4x3 props, Emax ECO II 2306 1700KV motors, 1.124 kg total.
     Gazebo ENU frame: SDF pos = (CA_PX, -CA_PY). Channels: rotors 0..5, tilt servos 6..11.
     PX4 airframe: 25006_gazebo-classic_mini_tilt_hexa. -->
<sdf version='1.6'>
  <model name='mini_tilt_hexa'>
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
